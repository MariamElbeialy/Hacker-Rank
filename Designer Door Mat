if __name__ == '__main__':
    n, m = map(int, input().split())
    
    # Top cone
    for i in range(1, n, 2):
        print((".|." * i).center(m, '-'))
        
    # Welcome line
    print("WELCOME".center(m, '-'))
    
    # Bottom cone
    for i in range(n - 2, -1, -2):
        print((".|." * i).center(m, '-'))
