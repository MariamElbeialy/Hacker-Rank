from collections import defaultdict

if __name__ == '__main__':
    # Read n and m
    n, m = map(int, input().split())
    
    # Store group A words with their 1-based indices using a defaultdict
    d = defaultdict(list)
    for i in range(1, n + 1):
        word = input().strip()
        d[word].append(str(i))
        
    # Process each word in group B
    for _ in range(m):
        word = input().strip()
        # If the word exists in dictionary A, print its indices separated by space; otherwise print -1
        if word in d:
            print(" ".join(d[word]))
        else:
            print("-1")